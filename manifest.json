{
  "manifest_version": 3,
  "name": "FocusPilot",
  "version": "3.12.1",
  "description": "A focused productivity dashboard with tasks, notes, Pomodoro, reading list, statistics and URL blocking.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "alarms",
    "favicon"
  ],
  "action": {
    "default_title": "FocusPilot",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "chrome_url_overrides": {
    "newtab": "src/newtab.html"
  },
  "commands": {
    "open-command-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+P"
      },
      "description": "Open FocusPilot command palette"
    },
    "quick-capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+K"
      },
      "description": "Capture current page"
    }
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://www.google.co.uk/*",
        "https://www.google.ru/*"
      ],
      "css": [
        "src/google.css"
      ],
      "js": [
        "src/google.js"
      ],
      "run_at": "document_idle"
    }
  ]
}